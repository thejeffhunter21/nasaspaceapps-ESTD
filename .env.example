# Copy to .env for local work. Never commit .env. On Render, set these in the dashboard.
USE_MOCK=true
CORS_ORIGINS=http://localhost:8501
REQUEST_TIMEOUT_S=10
RATE_LIMIT_PER_MINUTE=60
OPENAI_API_KEY=
# Optional AI layer. Leave the key empty for deterministic fallback.
GEMINI_API_KEY=
# Set an available Gemini Flash model explicitly when enabling AI.
GEMINI_MODEL=
# Live AI calls are off unless this is 1 (a key alone never calls Gemini). Cached approved
# replies are still used when off. The trial tool's --live turns it on for one run.
GEMINI_LIVE=0
# Max requests to Gemini per UTC day, retries included (default 50; 0 turns AI off).
AI_DAILY_CALL_CAP=50
# Cache of checked AI explanations + today's call count (git-ignored).
EXPLAIN_CACHE_PATH=data/cache/explanations.json
