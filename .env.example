# Copy to .env for local work. Never commit .env. On Render, set these in the dashboard.
USE_MOCK=true
CORS_ORIGINS=http://localhost:8501
REQUEST_TIMEOUT_S=10
RATE_LIMIT_PER_MINUTE=60
OPENAI_API_KEY=
# Optional AI layer. Leave the key empty for deterministic fallback.
GEMINI_API_KEY=
# Set an available Gemini Flash model explicitly when enabling AI.
GEMINI_MODEL=
